{
  "name": "@kraude-kode/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun --packages external",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "typecheck": "bun check",
    "test": "bunx --bun vitest run --config ../../vitest.config.ts --root ."
  },
  "dependencies": {
    "@kraude-kode/daemon": "workspace:*",
    "@kraude-kode/events": "workspace:*",
    "@opentui/core": "^0.6.6",
    "diff": "^9.0.0"
  }
}
