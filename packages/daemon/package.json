{
  "name": "@claudin/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/daemonClient.ts"
  },
  "scripts": {
    "dev": "bun build ./src/index.ts --outdir dist --target bun --packages external --watch",
    "build": "bun build ./src/index.ts --outdir dist --target bun --packages external",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "typecheck": "bun check",
    "test": "bunx --bun vitest run --config ../../vitest.config.ts --root ."
  },
  "dependencies": {
    "@claudin/agent": "workspace:*",
    "@claudin/events": "workspace:*",
    "fuzzysort": "^4.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
